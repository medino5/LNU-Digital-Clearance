APP_NAME="Digital Clearance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-render-service.onrender.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=postgres://postgres.PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

CLEARANCE_CURRENT_SEMESTER=1st
CLEARANCE_CURRENT_ACADEMIC_YEAR=2025-2026
RUN_DATABASE_SEEDER=true
